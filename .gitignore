# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store
__MACOSX/

# Internal dev-only docs (code review, security notes, tech debt, changelog)
.internal/

# Claude Code project instructions — kept at repo root so Claude Code auto-loads
# it, but not published to the public repo.
CLAUDE.md

# Database files (generated, keep directory)
data/*.db
data/*.db-wal
data/*.db-shm

# Master key for host-password encryption (must never be committed)
data/.secret_key

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/

# Generated reports and keys (keep directories)
reports/*
keys/*

# Docker
Dockerfile.local
docker-compose.override.yml

# Environment / secrets
.env
.env.local
*.pem
*.key

# Logs
*.log
